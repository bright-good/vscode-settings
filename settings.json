// =====================================================================
// VS Code ユーザー設定（Windows）
// 置き場所: %APPDATA%\Code\User\settings.json
//
// 前提
//   - Windows 11
//   - VS Code（ユーザーインストール版。%LOCALAPPDATA%\Programs\Microsoft VS Code）
//   - Git for Windows（C:\Program Files\Git に入っていること。Git Bash を使う）
//   - 拡張機能: Java 拡張（Extension Pack for Java）、Checkstyle for Java
//   - ソースは Shift_JIS と UTF-8 が混在している
//   - PowerShell のスクリプト実行は禁止されている環境を想定（プロファイルを使わない）
//
// 置き換えが必要な箇所
//   <USER>              Windows のユーザー名
//   <COMMIT>            VS Code のフォルダ名（コミットハッシュ。更新で変わることがある）
//   <TOMCAT_HOME>       Tomcat のインストール先
//   <CHECKSTYLE_CONFIG> Checkstyle の設定ファイル
// =====================================================================
{
    // ===== Java =====

    // ソースフォルダ外の jar をクラスパスに加える
    // （Maven/Gradle を使わない Web アプリ。WEB-INF\lib と Tomcat の servlet-api）
    "java.project.referencedLibraries": [
        "WEB-INF\\lib\\*.jar",
        "<TOMCAT_HOME>\\lib\\servlet-api.jar"
    ],

    // Checkstyle for Java 拡張の設定
    // version: 使う Checkstyle のバージョン。設定ファイルが対応するものに合わせる
    // configuration: ルールを書いた xml
    "java.checkstyle.version": "8.18",
    "java.checkstyle.configuration": "<CHECKSTYLE_CONFIG>.xml",
    "java.checkstyle.properties": {},
    "java.checkstyle.modules": [],

    // ===== ターミナル =====

    // ターミナルの PATH の先頭に、VS Code 内蔵の rg.exe があるフォルダを足す
    // rg を別にインストールしなくて済む
    // <COMMIT> は VS Code の更新で変わることがある。rg: command not found が出たら次のコマンド（PowerShell）で探して書き換える
    //   Get-ChildItem "$env:LOCALAPPDATA\Programs\Microsoft VS Code" -Recurse -Filter rg.exe -ErrorAction SilentlyContinue | Where-Object { $_.FullName -like '*\@vscode\ripgrep*' } | Select-Object FullName
    // （Copilot 拡張も rg.exe を持っているので、@vscode\ripgrep を含むものを選ぶ）
    "terminal.integrated.env.windows": {
        "PATH": "C:\\Users\\<USER>\\AppData\\Local\\Programs\\Microsoft VS Code\\<COMMIT>\\resources\\app\\node_modules.asar.unpacked\\@vscode\\ripgrep-universal\\bin\\win32-x64;${env:PATH}"
    },

    // ターミナルの種類（プロファイル）
    // PowerShell / Command Prompt / Git Bash は VS Code の既定と同じ内容
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        },

        // ===== rg 検索（Shift_JIS と UTF-8 の両方を検索） =====
        // VS Code の検索（Ctrl+Shift+F）は Shift_JIS のファイル内の日本語がヒットしない。
        // そのため Git Bash に検索用の関数を定義して起動するプロファイルを作る。
        // 関数は settings.json だけで完結させるため args に1行で書いている（JSON は文字列内で改行できない）。
        // 読むときは Alt+Z で折り返し表示にする。
        //
        // rgj  [オプション] "検索語" [行数]  ターミナルに結果を表示
        // rgjf [オプション] "検索語" [行数]  結果を .code-search ファイルにして VS Code で開く
        //                                  （VS Code の検索結果と同じ形式。行をクリックするとソースへ飛ぶ）
        // 中身は共通の rgjx。rgj は rgjx t、rgjf は rgjx f を呼ぶ
        //
        // オプション（検索語より前に書く。rgj と rgjf で共通）
        //   -w          単語単位
        //   -c          大文字小文字を区別する（既定は区別しない）
        //   -r          正規表現（既定は文字どおり）
        //   -i "glob"   含めるファイル（複数回指定可）
        //   -x "glob"   除外するファイル（複数回指定可）
        //   行数         一致した行の前後に表示する行数（省略時 0）
        //
        // 例: rgjf -w -c -i "*.java" -x "test/**" "p_cnvcf" 2
        // 同じファイルが両方の検索に出たら1つにまとめる（UTF-8 で文字化けしなければ UTF-8 の結果を使う）
        // 結果はファイルのパス順に並べる（大文字小文字は区別しない）
        // rgjf の結果ファイルは rg-日時.code-search としてカレントディレクトリに作られる（溜まるので不要分は手で消す）
        // rgjf の結果では一致箇所の黄色ハイライトは付かない（Ctrl+F で検索語を入れると代わりになる）
        // keybindings.json にキーを割り当てると、選択した文字列でそのまま検索できて楽（README 参照）
        "Git Bash (rg)": {
            "path": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": ["-c", "rgjx() { local md=$1 OPTIND=1 o fl= inc= exc= g= s=-i r=-F cl= q c f; shift; while getopts 'wcri:x:' o; do case $o in w) g=\"$g -w\"; fl=\"$fl WordMatch\";; c) s=-s; fl=\"$fl CaseSensitive\";; r) r=; fl=\"$fl RegExp\";; i) g=\"$g -g $OPTARG\"; [ -z \"$inc\" ] && inc=$OPTARG || inc=\"$inc, $OPTARG\";; x) g=\"$g -g !$OPTARG\"; [ -z \"$exc\" ] && exc=$OPTARG || exc=\"$exc, $OPTARG\";; esac; done; shift $((OPTIND-1)); q=$1; c=$2; [ -z \"$c\" ] && c=0; f=/dev/stdout; [ \"$md\" = t ] && cl='--color=always --colors path:fg:magenta --colors line:none --colors match:fg:red --colors match:style:bold' || f=rg-$(date +%Y%m%d%H%M%S).code-search; set -f; { rg -E utf-8 -n --heading -C \"$c\" $cl $s $r $g -g '!rg-*.code-search' -e \"$q\"; echo '@@SJIS@@'; rg -E sjis -n --heading -C \"$c\" $cl $s $r $g -g '!rg-*.code-search' -e \"$q\"; } | LC_ALL=C awk 'BEGIN{s=0;R=\"\\033[0m\"} {sub(/\\r$/,\"\")} substr($0,1,4)==R && substr($0,5,1)~/[0-9]/{t=substr($0,5);i=index(t,R);a=substr(t,i+4);b=substr(a,2);if(substr(b,1,4)==R)b=substr(b,5);$0=substr(t,1,i-1) substr(a,1,1) b} /^@@SJIS@@$/{s=1;next} /^$/{next} /^(\\033\\[[0-9;]*m)*--(\\033\\[[0-9;]*m)*$/{B[k]=B[k] \"--\\002\";next} /^[0-9]+[:-]/{B[k]=B[k] $0 \"\\002\";next} {k=s SUBSEP $0; if(!($0 in V)){V[$0]=1;O[++n]=$0}} END{for(i=1;i<=n;i++){p=O[i];u=B[0 SUBSEP p];j=B[1 SUBSEP p];x=(u!=\"\" && index(u,\"\\357\\277\\275\")==0)?u:(j!=\"\"?j:u);h=split(x,L,\"\\002\");for(e=1;e<h;e++)if(L[e]~/^[0-9]+:/)c++;print p \"\\001\" x}print \"\\001\" c+0 \"\\001\" n+0}' | LC_ALL=C /usr/bin/sort -f | M=$md Q=$q FL=$fl INC=$inc EXC=$exc C=$c LC_ALL=C awk 'BEGIN{t=ENVIRON[\"M\"]==\"t\"} NR==1{split($0,H,\"\\001\");if(!t)printf \"# Query: %s\\n# Flags:%s\\n# Including: %s\\n# Excluding: %s\\n# ContextLines: %s\\n\\n%d 件の結果 - %d ファイル\\n\\n\",ENVIRON[\"Q\"],ENVIRON[\"FL\"],ENVIRON[\"INC\"],ENVIRON[\"EXC\"],ENVIRON[\"C\"],H[2],H[3];next} {i=index($0,\"\\001\");p=substr($0,1,i-1);k=split(substr($0,i+1),L,\"\\002\");print t?p:p \":\";for(j=1;j<k;j++){l=L[j];if(t)print l;else if(l~/^[0-9]+:/){sub(/:/,\": \",l);print \"  \" l}else if(l~/^[0-9]+-/){sub(/-/,\" \",l);print \"  \" l}}print \"\"} END{if(t)printf \"%d 件の結果 - %d ファイル\\n\",H[2],H[3]}' > $f; set +f; [ \"$md\" = t ] || code $f; }; rgj() { rgjx t \"$@\"; }; rgjf() { rgjx f \"$@\"; }; export -f rgjx rgj rgjf; exec /usr/bin/bash --login -i"]
        }
    },

    // 新しいターミナルを開いたときに使うプロファイル
    "terminal.integrated.defaultProfile.windows": "Git Bash (rg)",

    // ターミナルに残す行数（既定 1000）。rgj の結果が多くても遡れるように増やす
    "terminal.integrated.scrollback": 30000
}
